# ─── Li.Fi (EVM) ───────────────────────────────────────────────
LIFI_API_KEY=your_lifi_api_key
LIFI_INTEGRATOR=tknz

# EVM fee wallet — Li.Fi FeeForwarder pushes the 0.15% fee here directly
# at every swap execution (no claim/withdraw step). Register the destination
# wallet for your integrator string at portal.li.fi BEFORE going live or
# fees will route to a default address. Use a multisig you control.
NEXT_PUBLIC_LIFI_FEE_WALLET_EVM=0xYourEvmFeeWallet

# ─── DFlow (Solana only) ───────────────────────────────────────
DFLOW_API_KEY=your_dflow_api_key

# Solana fee account — DFlow deposits the 0.15% platform fee here per swap.
# This is a base58 Solana public key (~44 chars), e.g. 5Q544fKrFoe6tsEbD7S8EmxGTJYAKtTVhAW5Q5pge4j1
# Generate via Phantom/Solflare/`solana-keygen` and fund with ~0.01 SOL for
# rent exemption. The associated SPL token accounts for each swappable
# output mint will be created on-demand at first fee deposit.
NEXT_PUBLIC_DFLOW_FEE_ACCOUNT=YourSolanaFeeWalletPublicKey

# ─── RPC Endpoints ────────────────────────────────────────────
NEXT_PUBLIC_ETH_RPC=https://eth.llamarpc.com
NEXT_PUBLIC_ARB_RPC=https://arb1.arbitrum.io/rpc
NEXT_PUBLIC_BASE_RPC=https://mainnet.base.org
NEXT_PUBLIC_OP_RPC=https://mainnet.optimism.io
NEXT_PUBLIC_POLYGON_RPC=https://polygon-rpc.com
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# ─── WalletConnect ────────────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id

# ─── Fee Config ───────────────────────────────────────────────
NEXT_PUBLIC_FEE_BPS=15
NEXT_PUBLIC_FEE_FLOAT=0.0015

# ─── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://tknz.xyz
NEXT_PUBLIC_APP_ENV=production
# DATABASE_URL=postgresql://...
